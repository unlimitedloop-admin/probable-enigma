root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = false
cpp_include_cleanup_alternate_files = pch.h:memory, pch.h:utility, pch.h:string, pch.h:algorithm, pch.h:chrono, pch.h:deque, pch.h:fstream, pch.h:map, pch.h:sstream, pch.h:unordered_map, pch.h:vector, pch.h:DxLib.h, pch.h:config/SystemConfig.h, pch.h:Windows.h
