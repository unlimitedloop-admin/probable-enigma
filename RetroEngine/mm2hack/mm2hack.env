# ######################################
#
# Environment Parameter
#
# ######################################

# This row is comment line.
# If the first character has a sharpmark, it's decided to be a commented line.
# The parameter set is valid by entering it as follows ...
# $[Parameter Name] [Parameter Value]

# Example:
# $MM2HACK_DEBUG true


# MM2HACK_DEBUG: Enable debug mode.
$MM2HACK_DEBUG true

# WINDOW_TEXT: The text to be displayed in the window title.
$WINDOW_TEXT mm2hack (demo)

# MM2HACK_VERSION: The version of the mm2hack.
$MM2HACK_VERSION v0.0.1

# OUTPUT_LOG_ENABLE: Enable output log.
$OUTPUT_LOG_ENABLE false

# WINDOW_ALWAYS_RUN_ENABLE: Specifies whether the application should always run in the window.
$WINDOW_ALWAYS_RUN_ENABLE false
