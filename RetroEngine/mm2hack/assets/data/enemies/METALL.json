{
    "id": "metall",
    "enemy_type": "minion",
    "name": "METALL",
    "initial_state": "hidden",
    "states": [
        {
            "id": "hidden",
            "loop": false,
            "allow_movement": false,
            "frames": [
                { "tile": 0, "wait": "hold" }
            ],
            "transitions": [
                { "when": "timer", "frames": 90, "to": "wake_up" }
            ]
        },
        {
            "id": "wake_up",
            "loop": false,
            "allow_movement": false,
            "frames": [
                { "tile": 0, "wait": 6 },
                { "tile": 1, "wait": 6 },
                { "tile": 2, "wait": 6 },
                { "tile": 3, "wait": 6 }
            ],
            "transitions": [
                { "when": "clip_finished", "to": "walk", "projectile_spawns": [
                    { "angle_deg": 0, "speed_px_per_frame": 3.0 },
                    { "angle_deg": -45, "speed_px_per_frame": 3.0 },
                    { "angle_deg": 45, "speed_px_per_frame": 3.0 }
                ] },
                { "when": "airborne", "to": "falling" }
            ]
        },
        {
            "id": "walk",
            "loop": true,
            "move_speed_multiplier": 1.25,
            "frames": [
                { "tile": 4, "wait": 8 },
                { "tile": 5, "wait": 8 },
                { "tile": 6, "wait": 8 },
                { "tile": 7, "wait": 8 }
            ],
            "transitions": [
                { "when": "airborne", "to": "falling" },
                { "when": "timer", "frames": 150, "to": "falling", "jump_impulse": -4.0 }
            ]
        },
        {
            "id": "falling",
            "loop": false,
            "move_speed_multiplier": 2.0,
            "frames": [
                { "tile": 10, "wait": "hold" }
            ],
            "transitions": [
                { "when": "grounded", "to": "walk" }
            ]
        }
    ],
    "palette_presets": [
        { "id": "default", "mappings": [] },
        { "id": "yellow", "mappings": [ { "source": 39, "target": 40 } ] },
        { "id": "blue", "mappings": [ { "source": 39, "target": 17 } ] },
        { "id": "red", "mappings": [ { "source": 39, "target": 6 } ] }
    ]
}
