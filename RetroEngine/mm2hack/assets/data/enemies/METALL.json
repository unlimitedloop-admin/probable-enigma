{
    "id": "metall",
    "enemy_type": "minion",
    "name": "METALL",
    "initial_state": "idle",
    "states": [
        {
            "id": "idle",
            "loop": false,
            "allow_movement": false,
            "frames": [
                { "tile": 0, "wait": "hold" }
            ],
            "transitions": [
                { "when": "player_near", "x": 48, "y": 24, "to": "rise" }
            ]
        },
        {
            "id": "rise",
            "loop": false,
            "allow_movement": false,
            "frames": [
                { "tile": 0, "wait": 6 },
                { "tile": 1, "wait": 6 },
                { "tile": 2, "wait": 6 },
                { "tile": 3, "wait": 6 }
            ],
            "transitions": [
                { "when": "clip_finished", "to": "jump", "jump_impulse": -4.0, "projectile_spawns": [
                    { "angle_deg": 0, "speed_px_per_frame": 3.0 },
                    { "angle_deg": -45, "speed_px_per_frame": 3.0 },
                    { "angle_deg": 45, "speed_px_per_frame": 3.0 }
                ] }
            ]
        },
        {
            "id": "jump",
            "loop": false,
            "move_speed_multiplier": 1.5,
            "frames": [
                { "tile": 4, "wait": 6 },
                { "tile": 8, "wait": 6 },
                { "tile": 9, "wait": 6 },
                { "tile": 10, "wait": 6 },
                { "tile": 11, "wait": "hold" }
            ],
            "transitions": [
                { "when": "grounded", "to": "cooldown" }
            ]
        },
        {
            "id": "cooldown",
            "loop": false,
            "allow_movement": false,
            "frames": [
                { "tile": 0, "wait": "hold" }
            ],
            "transitions": [
                { "when": "timer", "frames": 30, "to": "idle" }
            ]
        }
    ],
    "palette_presets": [
        { "id": "default", "mappings": [] },
        { "id": "yellow", "mappings": [ { "source": 39, "target": 40 } ] },
        { "id": "blue", "mappings": [ { "source": 39, "target": 17 } ] },
        { "id": "red", "mappings": [ { "source": 39, "target": 6 } ] }
    ]
}
